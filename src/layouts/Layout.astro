---
import astroBackground from "../assets/background.svg";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/astro.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro Basics</title>
    </head>
    <body style={`background-image: url("${astroBackground.src}")`}>
        <header class="site-header">
            <a class="brand" href="/">Astro</a>
            <nav aria-label="Main navigation">
                <a class="nav-link active" href="/">Home</a>
                <a class="nav-link" href="/blog">Blog</a>
                <a class="nav-link" href="/about">About</a>
            </nav>
        </header>

        <main class="hero">
            <div class="hero-content">
                <slot />
            </div>
        </main>
        <footer>
            <p>
                Need help? Check out the <a href="https://docs.astro.build"
                    >Astro documentation</a
                > or join the
                <a href="https://astro.build/chat">Astro Discord server</a>.
            </p>
        </footer>
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
        min-height: 100%;
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover;
        color: #17191e;
        font-family: Georgia, "Times New Roman", serif;
    }

    body {
        min-height: 100vh;
        padding: 28px 6vw 56px;
    }

    .site-header {
        align-items: center;
        display: flex;
        justify-content: space-between;
        margin: 0 auto;
        max-width: 1180px;
    }

    .brand {
        color: #17191e;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
    }

    nav {
        display: flex;
        gap: 8px;
    }

    .nav-link {
        border: 1px solid transparent;
        border-radius: 999px;
        color: #17191e;
        font-family: Arial, sans-serif;
        font-size: 0.82rem;
        padding: 10px 16px;
        text-decoration: none;
        transition:
            background-color 160ms ease,
            border-color 160ms ease;
    }

    .nav-link:hover,
    .nav-link.active {
        background: rgba(255, 255, 255, 0.58);
        border-color: rgba(23, 25, 30, 0.14);
    }

    .hero {
        align-items: center;
        display: flex;
        margin: 0 auto;
        max-width: 1180px;
        min-height: calc(100vh - 150px);
    }

    .hero-content {
        max-width: 650px;
    }

    .hero-content :global(h1) {
        font-size: clamp(3.5rem, 9vw, 7.5rem);
        line-height: 0.92;
        margin: 0 0 28px;
        max-width: 700px;
    }

    .hero-content :global(p) {
        font-family: Arial, sans-serif;
        font-size: 1.05rem;
        line-height: 1.7;
        margin: 12px 0;
        max-width: 560px;
    }

    .hero-content :global(a) {
        color: #17191e;
        font-weight: 700;
    }

    .hero-content :global(code) {
        background: rgba(255, 255, 255, 0.5);
        border-radius: 4px;
        font-size: 0.9em;
        padding: 3px 6px;
    }

    @media (max-width: 600px) {
        body {
            padding: 20px 24px 40px;
        }

        .site-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 18px;
        }

        nav {
            width: 100%;
        }

        .nav-link {
            flex: 1;
            text-align: center;
        }

        .hero {
            min-height: calc(100vh - 160px);
        }
    }
</style>
